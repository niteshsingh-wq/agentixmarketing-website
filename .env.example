# ── Core ────────────────────────────────────────────────────────────────────
PAYLOAD_SECRET=change-this-to-a-random-32-char-secret
NEXT_PUBLIC_SERVER_URL=https://www.agentixmarketing.com

# ── Database (Neon Postgres) ────────────────────────────────────────────────
# payload.config.ts prefers DATABASE_URL_UNPOOLED, falling back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
DATABASE_URL=

# ── Transactional email (Google Workspace SMTP) ─────────────────────────────
# NOTE: this project uses Gmail SMTP, not Brevo. src/lib/email.ts authenticates
# as GMAIL_USER and sends as the connect@agentixmarketing.com domain alias.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=connect@agentixmarketing.com

# ── Google Sheets — lead capture (service account JSON key) ─────────────────
# OPTIONAL. If any of these are unset, appendLeadToSheet() logs a
# "[sheets] NOT CONFIGURED" warning and skips. Lead capture to Payload and the
# notification emails are unaffected.
# GOOGLE_SHEETS_PRIVATE_KEY must keep its literal \n escapes when stored in Vercel.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# ── Microsoft Teams — new lead notifications ────────────────────────────────
# OPTIONAL. Power Automate HTTP trigger URL. Unset => "[teams] NOT CONFIGURED".
TEAMS_WEBHOOK_URL=

# ── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=

# ── Seeding ─────────────────────────────────────────────────────────────────
# Required by POST /api/seed, supplied via the x-seed-secret header.
SEED_SECRET=

# ── Content source ──────────────────────────────────────────────────────────
# Unset (hybrid): Payload first, static src/data fallback for slugs Payload lacks.
# "payload": Payload is authoritative — deleted/renamed CMS records 404 and leave
# the sitemap. Only set once production Payload holds every live service and
# case study. Must be set before the build (it shapes generateStaticParams).
CONTENT_SOURCE=

# ── Migration safety (read by scripts/migrate.mjs during `pnpm build`) ─────
# Production deployments always migrate. Preview builds migrate ONLY when this
# is "true" — set it (Preview scope) only once Preview has its own database.
PREVIEW_DATABASE_ISOLATED=
# Local/CI builds skip migrations unless this is "true".
ALLOW_LOCAL_MIGRATE=
