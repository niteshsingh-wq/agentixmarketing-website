PAYLOAD_SECRET=change-this-to-a-random-32-char-secret
NEXT_PUBLIC_SERVER_URL=https://agentixmarketing.com

# SQLite database file path (default: ./agentix.db in app root)
# DATABASE_URL=file:./agentix.db

# Brevo SMTP for contact form emails
BREVO_USER=
BREVO_SMTP_KEY=
NOTIFY_EMAIL=connect@agentixmarketing.com

# Google Sheets — lead capture (service account JSON key)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Microsoft Teams — new lead notifications (Power Automate HTTP trigger URL)
TEAMS_WEBHOOK_URL=
