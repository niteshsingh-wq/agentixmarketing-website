1d:["$","section",null,{"className":"section theme-light","id":"audit","children":["$","div",null,{"className":"wrap","children":["$","div",null,{"className":"lead-shell","children":[["$","$L22",null,{"className":"lead-intro","children":[["$","span",null,{"className":"eyebrow","children":"Start here"}],["$","h2",null,{"style":{"marginTop":18},"children":"See what your store is leaving on the table."}],["$","p",null,{"children":"Run a free instant SEO audit, or book a 30-minute strategy session. Either way you leave with specific, prioritised fixes — no obligation."}],["$","div",null,{"className":"lead-trust","children":[["$","div",null,{"className":"lt","children":[["$","svg",null,{"width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","children":["$","path",null,{"d":"M5 12.5L10 17.5L19 7","stroke":"currentColor","strokeWidth":"2.2","strokeLinecap":"round","strokeLinejoin":"round"}]}],["$","div",null,{"children":["Live audit in ~20 seconds ",["$","span",null,{"children":"— score + top fixes."}]]}]]}],["$","div",null,{"className":"lt","children":[["$","svg",null,{"width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","children":["$","path",null,{"d":"M5 12.5L10 17.5L19 7","stroke":"currentColor","strokeWidth":"2.2","strokeLinecap":"round","strokeLinejoin":"round"}]}],["$","div",null,{"children":["Strategy call with a senior specialist ",["$","span",null,{"children":"— not a sales rep."}]]}]]}],["$","div",null,{"className":"lt","children":[["$","svg",null,{"width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","children":["$","path",null,{"d":"M5 12.5L10 17.5L19 7","stroke":"currentColor","strokeWidth":"2.2","strokeLinecap":"round","strokeLinejoin":"round"}]}],["$","div",null,{"children":["Clear next steps ",["$","span",null,{"children":"— whether you hire us or not."}]]}]]}]]}]]}],["$","$L22",null,{"className":"lead-card theme-dark","style":{"borderRadius":"var(--radius)"},"children":["$","$L24",null,{}]}]]}]}]}]
1e:["$","section",null,{"className":"section theme-light","children":["$","div",null,{"className":"wrap","children":[["$","$L22",null,{"style":{"maxWidth":680},"children":[["$","span",null,{"className":"eyebrow","children":"Questions"}],["$","h2",null,{"className":"h2","style":{"marginTop":18},"children":"Good to know."}]]}],["$","$L22",null,{"children":["$","$L25",null,{"items":[["What is AI SEO analytics AEO GEO?","AI SEO analytics AEO GEO refers to three connected practices: machine-learning analytics that surface optimization opportunities faster, Answer Engine Optimization (AEO) to get cited in direct AI answers, and Generative Engine Optimization (GEO) for inclusion in longer AI-generated responses. Together, AI SEO analytics AEO GEO and website to be cited as the answer by AI assistants — ChatGPT, Perplexity, Gemini and Google AI Overviews — rather than just ranking in traditional search results. It involves structured content formatting, entity optimization, schema markup and E-E-A-T signal building."],["How does AI SEO analytics AEO GEO work for my business?","GEO is optimizing your brand's presence so that large language models include you in the responses they generate. Unlike traditional SEO which targets a specific keyword ranking, GEO targets brand inclusion in AI-generated answers across an entire topic space."],["Does AI SEO replace traditional SEO?","No — it extends it. Strong technical SEO, quality content and authoritative backlinks remain foundational. AI SEO adds a layer of optimization specifically for the growing share of queries answered directly by AI. The businesses winning in 2026 are doing both."],["How do I know if AI search is affecting my business?","If your organic traffic has plateaued or declined while your rankings stayed stable, AI Overviews may be answering queries before users click your results. We can audit your specific keyword set and quantify the AI search impact in a discovery session."]]}]}]]}]}]
