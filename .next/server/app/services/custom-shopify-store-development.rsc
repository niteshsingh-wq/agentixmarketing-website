1d:["$","section",null,{"className":"section theme-light","id":"audit","children":["$","div",null,{"className":"wrap","children":["$","div",null,{"className":"lead-shell","children":[["$","$L22",null,{"className":"lead-intro","children":[["$","span",null,{"className":"eyebrow","children":"Start here"}],["$","h2",null,{"style":{"marginTop":18},"children":"See what your store is leaving on the table."}],["$","p",null,{"children":"Run a free instant SEO audit, or book a 30-minute strategy session. Either way you leave with specific, prioritised fixes — no obligation."}],["$","div",null,{"className":"lead-trust","children":[["$","div",null,{"className":"lt","children":[["$","svg",null,{"width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","children":["$","path",null,{"d":"M5 12.5L10 17.5L19 7","stroke":"currentColor","strokeWidth":"2.2","strokeLinecap":"round","strokeLinejoin":"round"}]}],["$","div",null,{"children":["Live audit in ~20 seconds ",["$","span",null,{"children":"— score + top fixes."}]]}]]}],["$","div",null,{"className":"lt","children":[["$","svg",null,{"width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","children":["$","path",null,{"d":"M5 12.5L10 17.5L19 7","stroke":"currentColor","strokeWidth":"2.2","strokeLinecap":"round","strokeLinejoin":"round"}]}],["$","div",null,{"children":["Strategy call with a senior specialist ",["$","span",null,{"children":"— not a sales rep."}]]}]]}],["$","div",null,{"className":"lt","children":[["$","svg",null,{"width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","children":["$","path",null,{"d":"M5 12.5L10 17.5L19 7","stroke":"currentColor","strokeWidth":"2.2","strokeLinecap":"round","strokeLinejoin":"round"}]}],["$","div",null,{"children":["Clear next steps ",["$","span",null,{"children":"— whether you hire us or not."}]]}]]}]]}]]}],["$","$L22",null,{"className":"lead-card theme-dark","style":{"borderRadius":"var(--radius)"},"children":["$","$L24",null,{}]}]]}]}]}]
1e:["$","section",null,{"className":"section theme-light","children":["$","div",null,{"className":"wrap","children":[["$","$L22",null,{"style":{"maxWidth":680},"children":[["$","span",null,{"className":"eyebrow","children":"Questions"}],["$","h2",null,{"className":"h2","style":{"marginTop":18},"children":"Good to know."}]]}],["$","$L22",null,{"children":["$","$L25",null,{"items":[["What makes custom Shopify development different from using a Shopify theme?","A Shopify theme is a starting point built for thousands of different stores — it carries CSS, JavaScript and Liquid supporting features you'll never use, limiting your design freedom and slowing your store. Custom Shopify development produces a store built only for you: faster, more distinctive, more convertible, and easier to maintain."],["How long does custom Shopify store development take?","Most custom Shopify store builds take 4–8 weeks from design kickoff to launch depending on the number of page templates, integrations required and the number of design revision rounds. We'll give you a precise timeline after a free discovery call."],["Do you handle SEO as part of the build?","Yes — and this is a core Agentix advantage. We implement on-page SEO, technical SEO foundations and site architecture as part of the build. You won't need a separate SEO agency to fix what we built."],["What types of businesses do you build Shopify stores for?","We build custom Shopify stores across every vertical — fashion, beauty, skincare, health and wellness, home goods, food and drink, sporting goods, pet products, electronics, B2B wholesale and more. The Shopify platform is our constant; your industry is your advantage."]]}]}]]}]}]
