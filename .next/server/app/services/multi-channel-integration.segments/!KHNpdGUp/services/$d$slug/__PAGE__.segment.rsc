0:{"rsc":["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Service\",\"name\":\"Multi-Channel Integration for Shopify\",\"description\":\"Connect your Shopify store to Amazon, eBay, Walmart, TikTok Shop, wholesale portals and retail EDI systems. Unified inventory, centralized order management and synchronized product data.\",\"provider\":{\"@type\":\"Organization\",\"name\":\"Agentix\",\"url\":\"https://agentixmarketing.com\"},\"areaServed\":\"US\",\"url\":\"https://agentixmarketing.com/services/multi-channel-integration\"}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What sales channels can you connect to Shopify?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Amazon, eBay, Walmart, TikTok Shop, Etsy, Google Shopping, Meta Shops, wholesale portals and retail EDI systems. If there's an API or EDI standard, we can connect it.\"}},{\"@type\":\"Question\",\"name\":\"How do you handle inventory sync in real time?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We build webhook-based inventory sync that updates all connected channels when stock changes in Shopify — with configurable buffer stock rules to prevent oversells during sync latency windows.\"}},{\"@type\":\"Question\",\"name\":\"Can you connect Shopify to our wholesale EDI partners?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. We handle standard EDI formats (X12, EDIFACT) used by major US retailers including Target, Walmart, Nordstrom and others — translating EDI transactions into Shopify orders automatically.\"}}]}"}}],[["$","section",null,{"className":"svc-hero theme-dark","id":"top","children":[["$","div",null,{"className":"hero-glow"}],["$","div",null,{"className":"wrap","children":[["$","nav",null,{"className":"crumb