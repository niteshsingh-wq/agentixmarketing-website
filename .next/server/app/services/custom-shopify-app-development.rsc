20:["$","section",null,{"className":"section theme-light","children":["$","div",null,{"className":"wrap","children":[["$","$L17",null,{"style":{"maxWidth":680},"children":[["$","span",null,{"className":"eyebrow","children":"Questions"}],["$","h2",null,{"className":"h2","style":{"marginTop":18},"children":"Good to know."}]]}],["$","$L17",null,{"children":["$","$L25",null,{"items":[["When does a custom app make more sense than an existing Shopify app?","When your requirements are too specific for any existing app to fit well; when running 3–4 apps to cover one workflow creates conflicts and overhead; or when the monthly recurring cost of multiple apps exceeds the build cost of a single custom solution. We'll give you an honest assessment."],["How long does custom Shopify app development take?","Simple private apps take 2–4 weeks. Complex apps with multiple integrations typically take 6–12 weeks. We'll scope your app accurately after a requirements discovery session."],["Can you maintain an app another developer built?","Yes — we regularly take over existing custom Shopify apps. We start with a codebase audit so we understand what we're inheriting before committing to maintenance."]]}]}]]}]}]
