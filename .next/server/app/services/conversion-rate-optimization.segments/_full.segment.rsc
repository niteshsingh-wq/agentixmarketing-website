1d:["$","section",null,{"className":"section theme-light","id":"audit","children":["$","div",null,{"className":"wrap","children":["$","div",null,{"className":"lead-shell","children":[["$","$L22",null,{"className":"lead-intro","children":[["$","span",null,{"className":"eyebrow","children":"Start here"}],["$","h2",null,{"style":{"marginTop":18},"children":"See what your store is leaving on the table."}],["$","p",null,{"children":"Run a free instant SEO audit, or book a 30-minute strategy session. Either way you leave with specific, prioritised fixes — no obligation."}],["$","div",null,{"className":"lead-trust","children":[["$","div",null,{"className":"lt","children":[["$","svg",null,{"width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","children":["$","path",null,{"d":"M5 12.5L10 17.5L19 7","stroke":"currentColor","strokeWidth":"2.2","strokeLinecap":"round","strokeLinejoin":"round"}]}],["$","div",null,{"children":["Live audit in ~20 seconds ",["$","span",null,{"children":"— score + top fixes."}]]}]]}],["$","div",null,{"className":"lt","children":[["$","svg",null,{"width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","children":["$","path",null,{"d":"M5 12.5L10 17.5L19 7","stroke":"currentColor","strokeWidth":"2.2","strokeLinecap":"round","strokeLinejoin":"round"}]}],["$","div",null,{"children":["Strategy call with a senior specialist ",["$","span",null,{"children":"— not a sales rep."}]]}]]}],["$","div",null,{"className":"lt","children":[["$","svg",null,{"width":18,"height":18,"viewBox":"0 0 24 24","fill":"none","children":["$","path",null,{"d":"M5 12.5L10 17.5L19 7","stroke":"currentColor","strokeWidth":"2.2","strokeLinecap":"round","strokeLinejoin":"round"}]}],["$","div",null,{"children":["Clear next steps ",["$","span",null,{"children":"— whether you hire us or not."}]]}]]}]]}]]}],["$","$L22",null,{"className":"lead-card theme-dark","style":{"borderRadius":"var(--radius)"},"children":["$","$L24",null,{}]}]]}]}]}]
1e:["$","section",null,{"className":"section theme-light","children":["$","div",null,{"className":"wrap","children":[["$","$L22",null,{"style":{"maxWidth":680},"children":[["$","span",null,{"className":"eyebrow","children":"Questions"}],["$","h2",null,{"className":"h2","style":{"marginTop":18},"children":"Good to know."}]]}],["$","$L22",null,{"children":["$","$L25",null,{"items":[["What is a good conversion rate?","It depends heavily on industry and traffic source. Ecommerce average is 1.5–3%, with top performers hitting 4–5%+. Lead generation pages average 2–5%. SaaS free trial pages average 3–8%. The most important metric is your own conversion rate trend — is it improving or declining?"],["Do you need a lot of traffic for CRO to work?","Statistically valid A/B testing requires sufficient traffic — typically 500–1,000+ visitors per variant per test. For lower-traffic sites, we use qualitative CRO methods: expert heuristic review, heatmaps and session analysis to make high-confidence improvements without waiting for statistical significance."],["How is CRO different from UX design?","UX design creates the user experience. CRO tests and refines it based on behavioral data. Good CRO is built on good UX thinking, but proves its hypotheses with real user behavior rather than design intuition alone."],["Can you improve conversion rates without A/B testing?","Yes. Expert CRO review, heatmap analysis and session recording analysis often reveal clear, high-confidence fixes — broken form fields, unclear CTAs, trust signal gaps, mobile layout failures — that don't require A/B testing to justify implementing. We start with what's obviously broken before running structured tests."]]}]}]]}]}]
