1e:["$","section",null,{"className":"section theme-light","children":["$","div",null,{"className":"wrap","children":[["$","$L22",null,{"style":{"maxWidth":680},"children":[["$","span",null,{"className":"eyebrow","children":"Questions"}],["$","h2",null,{"className":"h2","style":{"marginTop":18},"children":"Good to know."}]]}],["$","$L22",null,{"children":["$","$L25",null,{"items":[["Will a platform migration to Shopify hurt my Google rankings?","Not if the platform migration to Shopify is executed correctly. Comprehensive 301 redirect mapping, structured data preservation and post-launch monitoring are what prevent ranking loss. When migrations hurt rankings, it's always because these steps were skipped or done incompletely — we don't skip them."],["How long does a Shopify migration take?","Most migrations take 4–10 weeks depending on catalog size, content volume, integration complexity and whether a redesign is happening simultaneously. We scope each migration individually in a free discovery call."],["Can you migrate from any platform?","We have migration experience from WooCommerce, Magento, BigCommerce, Squarespace, Wix, PrestaShop, Volusion and custom-built platforms. Each has specific export requirements — we handle all of it."],["What happens to my customer data and order history?","Customer records, order history and account data are migrated and preserved. Customers won't lose their purchase history or need to create new accounts. We verify data integrity in staging before any live migration."]]}]}]]}]}]
