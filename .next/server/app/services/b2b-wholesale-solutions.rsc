1e:["$","section",null,{"className":"section theme-light","children":["$","div",null,{"className":"wrap","children":[["$","$L22",null,{"style":{"maxWidth":680},"children":[["$","span",null,{"className":"eyebrow","children":"Questions"}],["$","h2",null,{"className":"h2","style":{"marginTop":18},"children":"Good to know."}]]}],["$","$L22",null,{"children":["$","$L25",null,{"items":[["Do I need Shopify Plus for Shopify B2B wholesale solutions?","Shopify Plus gives you the most robust native B2B features and is recommended for high-volume Shopify B2B wholesale solutions. For smaller wholesale setups, we can build effective B2B solutions on standard Shopify using custom pricing apps and custom account management. We'll recommend the right approach for your scale."],["Can you integrate ERP with Shopify B2B wholesale solutions?","Yes. Our Shopify B2B wholesale solutions integrate with NetSuite, SAP, Sage, Brightpearl, QuickBooks and custom ERPs. Integration scope depends on your ERP's API and what data needs to flow in both directions."],["Can B2B and DTC run on the same Shopify store?","Yes — this is a common setup. B2B buyers see their account pricing and bulk interfaces; DTC buyers see the standard storefront. Shopify Plus makes this cleanest with dedicated B2B storefronts, but it's achievable on standard Shopify with the right architecture."]]}]}]]}]}]
