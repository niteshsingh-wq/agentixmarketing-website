{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/cms/layout,_N_T_/cms/blog/layout,_N_T_/cms/blog/page,_N_T_/cms/blog"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/cms/blog/__PAGE__",
    "/cms/blog",
    "/cms",
    "/_index",
    "/_head"
  ]
}