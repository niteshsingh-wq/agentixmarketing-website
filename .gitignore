# dependencies — unanchored so nested copies (e.g. src/node_modules) match too
node_modules/

# next.js — Vercel builds this, never commit
/.next/
/out/
/build

# production
.standalone

# env — never commit secrets
.env.local
.env.*.local

# commit .env.example only

# misc
.DS_Store
*.pem
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pnpm
.pnp
.pnp.*

# debug
npm-debug.log*
yarn-debug.log*
*.pnpm-debug.log*

# SQLite database (lives on server, never commit)
*.db
*.db-shm
*.db-wal

# media uploads (server-side only)
/media

# scripts (deploy scripts are tracked)

